      "de.yourshika.betterpets.quickslots.BetterPetsQuickslots"
    ],
    "modmenu": [
      "de.yourshika.betterpets.quickslots.ModMenuIntegration"
    ]
  },
  "mixins": [
    "betterpets-quickslots.mixins.json"
  ],
  "depends": {
